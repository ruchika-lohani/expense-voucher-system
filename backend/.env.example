PORT=5000
NODE_ENV=development

# Option 1: use a single DATABASE_URL string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_voucher_db

# Option 2: use separate environment variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=expense_voucher_db
DB_SSL=false

JWT_SECRET=change-this-secret-key
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
